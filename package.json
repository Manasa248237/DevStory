{
  "name": "devstory-fullstack-blog",
  "version": "1.0.0",
  "description": "DevStory — Full-Stack Personal Blog Web Application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/server.js",
    "build": "npm run postinstall",
    "postinstall": "cd server && npm install && cd ../client && npm install && npm run build",
    "build:client": "cd client && npm install && npm run build",
    "build:server": "cd server && npm install",
    "build:all": "npm run postinstall",
    "server": "node server/server.js",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "seed": "node server/seed_articles.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "morgan": "^1.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
